{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          {
            "type": "deps",
            "release": "patch"
          },
          {
            "type": "build",
            "scope": "deps",
            "release": "patch"
          },
          {
            "type": "chore",
            "scope": "deps",
            "release": "patch"
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    "./release/morphe-dependency-notes.cjs",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "patch-tools/target/release/patch-tools",
            "label": "patch-tools-linux-x86_64"
          },
          {
            "path": "patch-tools/target/aarch64-apple-darwin/release/patch-tools",
            "label": "patch-tools-macos-aarch64"
          },
          {
            "path": "patch-tools/target/x86_64-pc-windows-gnu/release/patch-tools.exe",
            "label": "patch-tools-windows-x86_64.exe"
          }
        ]
      }
    ]
  ]
}
